# Telegram control
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=

# Wallet and chain
PRIVATE_KEY=
RPC_URL=
CONTRACT_ADDRESS=

# Exact contract-specific mint function, including every parameter.
# Example only: function publicMint(uint256 quantity) external payable
MINT_FUNCTION_SIGNATURE=
MINT_PRICE_ETH=
MAX_PER_WALLET=

# Official public-mint trigger. Supported types: function, timestamp, block.
# For function, MINT_TRIGGER_VALUE must be an exact view function signature
# returning bool, for example: function mintActive() view returns (bool)
MINT_TRIGGER_TYPE=
MINT_TRIGGER_VALUE=

# Gas safety
MAX_FEE_PER_GAS_GWEI=
MAX_PRIORITY_FEE_PER_GAS_GWEI=
GAS_LIMIT=
MAX_GAS_COST_ETH=

# Operational defaults
CONFIRMATIONS=1
MAX_ATTEMPTS=3
RETRY_BASE_DELAY_MS=2000
RETRY_MAX_DELAY_MS=30000
TOTAL_MINTS=1
WATCH_START=
WATCH_END=
POLL_INTERVAL_MS=1000

# Required for safe balance verification. Do not assume an ABI if the
# collection uses a non-standard ownership function.
NFT_BALANCE_SIGNATURE=

# Optional contract-specific checks. Leave blank only when the contract does
# not expose these checks or the official documentation says they are absent.
WALLET_MINT_COUNT_SIGNATURE=
PAUSE_FUNCTION_SIGNATURE=
SOLD_OUT_FUNCTION_SIGNATURE=